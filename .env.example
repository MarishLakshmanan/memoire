# Copy to .env and fill in. Never commit .env.

# "development" or "production".
# Audience validation is OFF in development because Clerk dev instances do not stamp `aud`.
APP_ENV=development

# Clerk instance that issues tokens. Frontend API URL, no trailing slash.
# Find it in the Clerk dashboard under API Keys.
CLERK_ISSUER=https://your-app.clerk.accounts.dev

# This server's RFC 8707 resource identifier. Must exactly match the MCP endpoint
# clients connect to, and the `aud` Clerk stamps on tokens.
MCP_RESOURCE_URL=http://localhost:8000/mcp

# PEM-encoded Clerk public key used to verify token signatures.
CLERK_PUBLIC_KEY_PATH=clerk.pem

# Frontend (phase 4) — note VITE_, not NEXT_PUBLIC_
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
